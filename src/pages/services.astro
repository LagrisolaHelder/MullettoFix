---
import { createClient } from '@supabase/supabase-js';
import "../styles/global.css";
import BaseLayout from '../layouts/BaseLayout.astro';


const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || import.meta.env.SUPABASE_URL;
const supabaseAnonKey =
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY || import.meta.env.SUPABASE_ANON_KEY;

const supabase =
  supabaseUrl && supabaseAnonKey ? createClient(supabaseUrl, supabaseAnonKey) : null;

let services = [];

if (supabase) {
  const { data, error } = await supabase
    .from('iphone_screen_repairs')
    .select('id, generation, model_name, category, display_type, estimated_total_gbp')
    .order('id', { ascending: true });

  if (!error && data) {
    services = data;
  }
}
---

 
  <BaseLayout>
  <main class="mx-auto max-w-6xl px-3 py-8 sm:px-6 sm:py-16">
      <header class="mb-6 sm:mb-10">
        <p class="mb-2 text-[10px] font-semibold uppercase tracking-[0.22em] text-green-600 sm:mb-3 sm:text-sm">Mulletto Fix</p>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">Phone Repair Services</h1>
      </header>

      {services.length === 0 ? (
        <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-5 py-8 text-center text-sm text-slate-600 shadow-sm sm:px-8 sm:py-12 sm:text-lg">
          No services available from the iphone_screen_repairs table.
        </div>
      ) : (
        <section class="grid grid-cols-2 gap-3 sm:gap-6 xl:grid-cols-3">
          {services.map((service) => (
            <article class="rounded-2xl border border-slate-200 bg-white p-3 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-md sm:p-6" key={service.id}>
              <div class="mb-3 flex items-center justify-between gap-2 sm:mb-5 sm:gap-3">
                <span class="inline-flex items-center rounded-full bg-green-100 px-2 py-1 text-[8px] font-bold uppercase tracking-[0.12em] text-green-700 sm:px-2.5 sm:text-[10px]">
                  {service.category || 'Repair'}
                </span>
                <span class="text-[10px] font-bold text-slate-500 sm:text-xs">#{service.id}</span>
              </div>

              <h2 class="mb-3 text-sm font-semibold leading-snug text-slate-900 sm:mb-4 sm:text-xl">
                {service.model_name || service.generation || 'Unknown model'}
              </h2>

              <div class="space-y-1.5 text-[10px] text-slate-600 sm:space-y-2 sm:text-sm">
                <p><span class="font-semibold text-slate-800">Generation:</span> {service.generation || 'N/A'}</p>
                <p><span class="font-semibold text-slate-800">Model:</span> {service.model_name || 'N/A'}</p>
                <p><span class="font-semibold text-slate-800">Category:</span> {service.category || 'N/A'}</p>
                <p><span class="font-semibold text-slate-800">Display:</span> {service.display_type || 'N/A'}</p>
              </div>

              <div class="mt-4 border-t border-slate-200 pt-3 text-base font-bold text-green-600 sm:mt-6 sm:pt-4 sm:text-lg">
                {new Intl.NumberFormat('en-GB', {
                  style: 'currency',
                  currency: 'GBP',
                  minimumFractionDigits: 2,
                }).format(Number(service.estimated_total_gbp ?? 0))}
              </div>
            </article>
          ))}
        </section>
      )}
    </main>
 
</BaseLayout>
