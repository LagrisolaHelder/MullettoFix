---
import "../styles/global.css";
import { ShoppingCart } from "lucide-astro";
 
---


<div class="sticky top-0 z-50 w-full border-b border-slate-200 bg-white/90 backdrop-blur-sm">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-x-6 px-4 py-4 sm:px-6" aria-label="Main navigation">
    <a class="text-xl font-bold tracking-tight text-slate-950 transition-colors hover:text-green-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-green-600" href="/" aria-label="Mullettofix home">Mullettofix<span class="text-green-600">.</span></a>

    <a class="rounded-md p-2 text-slate-600 transition-colors hover:bg-green-50 hover:text-green-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-green-600" href="#cart" aria-label="View cart">
      <ShoppingCart class="h-6 w-6" />
    </a>
  </nav>
</div>
